{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Task: Place ball on block GUI",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/../isaac_versions/new/IsaacLab-v3.0.0-beta2.patch1/env_isaaclab/bin/python",
      "program": "${workspaceFolder}/scripts/yam_pick_ball.py",
