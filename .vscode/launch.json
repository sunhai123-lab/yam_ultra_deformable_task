{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Task: Physical grasp GUI (one episode)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/../isaac_versions/new/IsaacLab-v3.0.0-beta2.patch1/env_isaaclab/bin/python",
      "program": "${workspaceFolder}/scripts/smoke_test_integrated_task.py",
      "args": [
        "--visualizer",
        "kit",
        "--keep-open",
        "--pick-lift",
        "--episodes",
        "1",
        "--steps-per-episode",
        "60",
        "--motion-steps",
        "240",
        "--lift-height",
        "0.05",
        "--seed",
        "7"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true,
      "env": {
        "OMNI_KIT_ACCEPT_EULA": "yes",
        "ACCEPT_EULA": "Y",
        "PYTHONUNBUFFERED": "1"
      }
    },
