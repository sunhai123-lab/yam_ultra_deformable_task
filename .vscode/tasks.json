{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Smoke: Integrated Reset (headless)",
      "type": "process",
      "command": "${workspaceFolder}/../isaac_versions/new/IsaacLab-v3.0.0-beta2.patch1/isaaclab.sh",
      "args": [
        "-p",
        "${workspaceFolder}/scripts/smoke_test_integrated_task.py",
        "--visualizer",
        "none",
        "--episodes",
        "3",
        "--steps-per-episode",
        "60",
        "--seed",
        "7"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "OMNI_KIT_ACCEPT_EULA": "yes",
          "ACCEPT_EULA": "Y",
          "PYTHONUNBUFFERED": "1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
