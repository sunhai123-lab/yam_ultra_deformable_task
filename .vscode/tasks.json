{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Task: Place ball on block GUI",
      "type": "process",
      "command": "${workspaceFolder}/../isaac_versions/new/IsaacLab-v3.0.0-beta2.patch1/isaaclab.sh",
      "args": [
        "-p", "${workspaceFolder}/scripts/yam_pick_ball.py",
        "--visualizer", "kit", "--keep-open", "--pick-lift", "--place-on-block",
        "--episodes", "3", "--steps-per-episode", "60", "--lift-height", "0.03", "--seed", "7"
      ],
      "options": {"cwd": "${workspaceFolder}", "env": {"OMNI_KIT_ACCEPT_EULA": "yes", "ACCEPT_EULA": "Y", "PYTHONUNBUFFERED": "1"}},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
      "group": {"kind": "build", "isDefault": true}
    },
    {
      "label": "Task: Reset and settle (headless)",
      "type": "process",
      "command": "${workspaceFolder}/../isaac_versions/new/IsaacLab-v3.0.0-beta2.patch1/isaaclab.sh",
      "args": [
        "-p", "${workspaceFolder}/scripts/yam_pick_ball.py",
        "--visualizer", "none", "--episodes", "3", "--steps-per-episode", "60", "--seed", "7"
      ],
      "options": {"cwd": "${workspaceFolder}", "env": {"OMNI_KIT_ACCEPT_EULA": "yes", "ACCEPT_EULA": "Y", "PYTHONUNBUFFERED": "1"}},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true}
    },
    {
      "label": "Task: Pick and lift (headless)",
      "type": "process",
      "command": "${workspaceFolder}/../isaac_versions/new/IsaacLab-v3.0.0-beta2.patch1/isaaclab.sh",
      "args": [
        "-p", "${workspaceFolder}/scripts/yam_pick_ball.py",
        "--visualizer", "none", "--pick-lift", "--episodes", "1", "--steps-per-episode", "60",
        "--lift-height", "0.03", "--seed", "7"
      ],
      "options": {"cwd": "${workspaceFolder}", "env": {"OMNI_KIT_ACCEPT_EULA": "yes", "ACCEPT_EULA": "Y", "PYTHONUNBUFFERED": "1"}},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true}
    },
    {
      "label": "Diagnostic: Gripper open-close GUI",
      "type": "process",
      "command": "${workspaceFolder}/../isaac_versions/new/IsaacLab-v3.0.0-beta2.patch1/isaaclab.sh",
      "args": [
        "-p", "${workspaceFolder}/scripts/yam_pick_ball.py",
        "--visualizer", "kit", "--keep-open", "--gripper-check",
        "--episodes", "1", "--steps-per-episode", "60", "--seed", "7"
      ],
      "options": {"cwd": "${workspaceFolder}", "env": {"OMNI_KIT_ACCEPT_EULA": "yes", "ACCEPT_EULA": "Y", "PYTHONUNBUFFERED": "1"}},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true}
    },
    {
      "label": "Assets: Convert YAM URDF to USD",
      "type": "process",
      "command": "${workspaceFolder}/../isaac_versions/new/IsaacLab-v3.0.0-beta2.patch1/isaaclab.sh",
      "args": ["-p", "${workspaceFolder}/scripts/convert_yam_ultra_2.py"],
      "options": {"cwd": "${workspaceFolder}", "env": {"OMNI_KIT_ACCEPT_EULA": "yes", "ACCEPT_EULA": "Y", "PYTHONUNBUFFERED": "1"}},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true}
    }
  ]
}
